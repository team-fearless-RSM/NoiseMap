rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // A user is a team editor only when an administrator has added their Auth UID
    // as a document in the teamMembers collection.
    function isTeamMember() {
      return signedIn() &&
        exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }

    // Public monitoring data. Only allowlisted team members can edit.
    match /locations/{documentId} {
      allow read: if true;
      allow create, update, delete: if isTeamMember();
    }

    match /devices/{documentId} {
      allow read: if true;
      allow create, update, delete: if isTeamMember();
    }

    match /observations/{documentId} {
      allow read: if true;
      allow create, update, delete: if isTeamMember();
    }

    // Private integration test records.
    match /endpoint_test_observations/{documentId} {
      allow read: if isTeamMember();
      allow write: if false;
    }

    // Staff actions and classroom alerts may contain sensitive classroom details.
    // Restrict all access to authenticated, allowlisted team members.
    match /actions/{documentId} {
      allow read, create, update, delete: if isTeamMember();
    }

    match /alerts/{alertId} {
      allow read, create, update, delete: if isTeamMember();
    }

    // Team membership documents are managed manually in Firebase Console.
    match /teamMembers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Deny access to every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
