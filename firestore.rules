rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Anyone can view published NoiseMap records. Only authenticated team accounts can change them.
    match /locations/{documentId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /devices/{documentId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /observations/{documentId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /actions/{documentId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}